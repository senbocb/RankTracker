    <div class="topbar-brand">Senbo</div>
    <ul class="topbar-links">
      <li><a href="#about">About</a></li>
      <li><a href="#ranks">Ranks</a></li>
      <li><a href="#events">Events</a></li>
      <li><a href="#setup">Setup</a></li>
