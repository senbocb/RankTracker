<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Senbo | Gaming Profile</title>
  <meta name="description" content="Competitive FPS player profile — ranks, setup, achievements, and socials.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0d1117;
      --bg-dark: #0a0e14;
      --bg-card: #151b23;
      --bg-card2: #1c2333;
      --bg-card-hover: #1a2230;
      --accent: #58a6ff;
      --accent-glow: rgba(88,166,255,0.15);
      --green: #3fb950;
      --gold: #d2a106;
      --pink: #f778ba;
      --purple: #bc8cff;
      --text: #c9d1d9;
      --text2: #8b949e;
      --text3: #6e7681;
      --text4: #484f58;
      --border: #30363d;
      --border2: #21262d;
      --radius: 8px;
      --radius-lg: 12px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ─── SUBTLE GRID BACKGROUND ─── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(88,166,255,0.08), transparent),
        linear-gradient(180deg, rgba(88,166,255,0.03) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    /* ─── TOP BAR ─── */
    .topbar {
      background: rgba(10,14,20,0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border2);
      padding: 0 32px;
      height: 48px;
      display: flex;
      align-items: center;
      gap: 32px;
      font-size: 12px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-brand {
      font-family: 'Orbitron', sans-serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 3px;
      color: var(--accent);
      text-transform: uppercase;
    }

    .topbar-links {
      display: flex;
      gap: 4px;
      list-style: none;
    }

    .topbar-links a {
      color: var(--text2);
      text-decoration: none;
      font-size: 12px;
      font-weight: 500;
      padding: 6px 12px;
      border-radius: 6px;
      transition: all 0.2s ease;
    }

    .topbar-links a:hover {
      color: #fff;
      background: rgba(255,255,255,0.06);
    }

    /* ─── PROFILE HEADER ─── */
    .profile-header {
      position: relative;
      z-index: 1;
      padding: 0 0 0;
      overflow: hidden;
    }

    .profile-banner {
      height: 200px;
      background:
        linear-gradient(135deg, #0d1117 0%, #161b22 40%, #1a1e2e 60%, #0d1117 100%);
      position: relative;
    }

    .profile-banner::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 20% 50%, rgba(88,166,255,0.12) 0%, transparent 50%),
        radial-gradient(circle at 80% 30%, rgba(188,140,255,0.08) 0%, transparent 40%),
        radial-gradient(circle at 50% 80%, rgba(63,185,80,0.06) 0%, transparent 40%);
    }

    .profile-banner::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 80px;
      background: linear-gradient(to top, var(--bg), transparent);
    }

    .profile-header-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 32px;
      position: relative;
      margin-top: -60px;
      display: flex;
      gap: 24px;
      align-items: flex-end;
      z-index: 2;
    }

    .profile-avatar {
      width: 128px;
      height: 128px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 3px solid var(--border);
      flex-shrink: 0;
      background: var(--bg-dark);
      position: relative;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .profile-avatar:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 20px rgba(88,166,255,0.1);
    }

    .profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-info {
      flex: 1;
      padding-bottom: 8px;
    }

    /* ─── MAIN LAYOUT ─── */
    .main-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 32px;
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 20px;
      position: relative;
      z-index: 1;
    }

    /* ─── SIDEBAR ─── */
    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border2);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      border-color: var(--border);
      box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    }

    .card-header {
      padding: 14px 18px;
      background: var(--bg-card2);
      border-bottom: 1px solid var(--border2);
      font-size: 11px;
      font-weight: 700;
      color: var(--text2);
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    .card-body { padding: 16px 18px; }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid var(--border2);
      font-size: 13px;
    }

    .info-row:last-child { border-bottom: none; }
    .info-label { color: var(--text3); font-size: 12px; }
    .info-val { color: var(--text); font-weight: 600; font-size: 13px; }

    .social-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border2);
      text-decoration: none;
      font-size: 13px;
      color: var(--text);
      transition: all 0.2s ease;
    }

    .social-link:last-child { border-bottom: none; }

    .social-link:hover {
      color: var(--accent);
      padding-left: 4px;
    }

    .social-link svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .social-link:hover svg { transform: scale(1.1); }

    .social-link-name { font-weight: 600; flex: 1; }
    .social-link-handle { color: var(--text3); font-size: 12px; }

    /* ─── SETUP LIST ─── */
    .setup-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 18px;
      border-bottom: 1px solid var(--border2);
      transition: background 0.2s ease;
    }

    .setup-item:last-child { border-bottom: none; }
    .setup-item:hover { background: rgba(255,255,255,0.02); }

    .setup-item-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--bg-dark);
      border: 1px solid var(--border2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: border-color 0.2s ease;
    }

    .setup-item:hover .setup-item-icon {
      border-color: var(--accent);
    }

    .setup-item-icon svg { width: 16px; height: 16px; }

    .setup-item-info { flex: 1; min-width: 0; }

    .setup-item-cat {
      font-size: 9px;
      color: var(--text3);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-weight: 600;
    }

    .setup-item-name {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
    }

    .setup-item-spec {
      font-size: 11px;
      color: var(--text3);
      margin-top: 1px;
    }

    .setup-item-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      padding: 3px 8px;
      border-radius: 20px;
      background: var(--accent-glow);
      color: var(--accent);
      border: 1px solid rgba(88,166,255,0.2);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
      flex-shrink: 0;
    }

    /* ─── CONTENT ─── */
    .content {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .content-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      background: var(--bg-card2);
      border-bottom: 1px solid var(--border2);
      font-size: 11px;
      font-weight: 700;
      color: var(--text2);
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    .content-header-icon {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
    }

    /* ─── ABOUT ─── */
    .about-text {
      font-size: 14px;
      color: var(--text2);
      line-height: 1.8;
    }

    .about-text strong { color: #fff; font-weight: 600; }

    /* ─── EVENTS ─── */
    .event-item {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border2);
      transition: background 0.15s ease;
    }

    .event-item:last-child { border-bottom: none; }
    .event-item:hover { background: rgba(255,255,255,0.015); }

    .event-date {
      flex-shrink: 0;
      width: 52px;
      text-align: center;
      background: var(--bg-dark);
      border: 1px solid var(--border2);
      border-radius: 10px;
      padding: 8px 4px;
    }

    .event-date-month {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      font-weight: 700;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .event-date-day {
      font-family: 'Orbitron', sans-serif;
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
    }

    .event-date-year {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      color: var(--text4);
    }

    .event-info { flex: 1; min-width: 0; }

    .event-name {
      font-weight: 700;
      font-size: 14px;
      color: #fff;
    }

    .event-detail {
      font-size: 12px;
      color: var(--text3);
      margin-top: 2px;
    }

    .event-place {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      background: rgba(205,127,50,0.12);
      color: #cd7f32;
      border: 1px solid rgba(205,127,50,0.25);
      vertical-align: middle;
      margin-left: 6px;
    }

    .event-links {
      display: flex;
      gap: 6px;
      margin-top: 8px;
    }

    .event-link {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      padding: 3px 10px;
      border-radius: 20px;
      background: var(--accent-glow);
      color: var(--accent);
      border: 1px solid rgba(88,166,255,0.15);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      transition: all 0.2s ease;
    }

    .event-link:hover {
      background: rgba(88,166,255,0.2);
      border-color: rgba(88,166,255,0.35);
      transform: translateY(-1px);
    }

    /* ─── RANKS ─── */
    .rank-game {
      border-bottom: 1px solid var(--border2);
      padding: 20px;
      transition: background 0.2s ease;
    }

    .rank-game:last-child { border-bottom: none; }
    .rank-game:hover { background: rgba(255,255,255,0.015); }

    .rank-game-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    .rank-game-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      overflow: hidden;
    }

    .rank-game-icon svg {
      width: 100%;
      height: 100%;
    }

    .rank-game-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      min-width: 0;
    }

    .rank-game-info { flex: 1; min-width: 0; }

    .rank-game-name {
      font-weight: 700;
      font-size: 15px;
      color: #fff;
    }

    .rank-game-meta {
      font-size: 12px;
      color: var(--text3);
      margin-top: 1px;
    }

    .rank-game-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .rank-list {
      display: flex;
      flex-direction: column;
    }

    .rank-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid var(--border2);
      gap: 12px;
    }

    .rank-row:last-child { border-bottom: none; }

    .rank-left {
      font-size: 13px;
      color: var(--text);
      font-weight: 500;
    }

    .rank-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .rank-current {
      font-family: 'Orbitron', sans-serif;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 12px;
      border-radius: 20px;
      white-space: nowrap;
    }

    .rank-peak {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      padding: 3px 12px;
      border-radius: 20px;
      white-space: nowrap;
    }

    .track-links {
      display: flex;
      gap: 6px;
      margin-top: 12px;
      padding-left: 48px;
    }

    .track-link {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      padding: 3px 10px;
      border-radius: 20px;
      background: var(--accent-glow);
      color: var(--accent);
      border: 1px solid rgba(88,166,255,0.15);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      transition: all 0.2s ease;
    }

    .track-link:hover {
      background: rgba(88,166,255,0.2);
      border-color: rgba(88,166,255,0.35);
      transform: translateY(-1px);
    }

    /* ─── FOOTER ─── */
    footer {
      border-top: 1px solid var(--border2);
      padding: 40px 32px;
      text-align: center;
      margin-top: 32px;
      position: relative;
      z-index: 1;
    }

    footer p {
      font-size: 12px;
      color: var(--text4);
      letter-spacing: 0.3px;
    }

    footer .footer-links {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 12px;
    }

    footer .footer-links a {
      color: var(--text3);
      text-decoration: none;
      font-size: 11px;
      transition: color 0.2s ease;
    }

    footer .footer-links a:hover { color: var(--accent); }

    /* ─── ENTRANCE ANIMATIONS ─── */
    .card, .rank-section {
      animation: fadeUp 0.5s ease both;
    }

    .card:nth-child(1) { animation-delay: 0.05s; }
    .card:nth-child(2) { animation-delay: 0.1s; }
    .card:nth-child(3) { animation-delay: 0.15s; }
    .card:nth-child(4) { animation-delay: 0.2s; }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 900px) {
      .main-wrap { grid-template-columns: 1fr; }
      .profile-header-inner {
        flex-direction: column;
        align-items: flex-start;
        margin-top: -40px;
      }
      .profile-avatar { width: 96px; height: 96px; }
      .profile-name { font-size: 26px; }
      .about-quick { grid-template-columns: 1fr; }
      .rank-sub-row { grid-template-columns: 1fr 1fr; padding-left: 18px; }
      .topbar-status { display: none; }
    }

    @media (max-width: 600px) {
      .topbar { padding: 0 16px; }
      .main-wrap { padding: 16px; }
      .profile-banner { height: 140px; }
      .profile-header-inner { padding: 0 16px; }
      .profile-name { font-size: 22px; }
      .rank-sub-row { grid-template-columns: 1fr; gap: 4px; }
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
